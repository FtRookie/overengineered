+	-- Rojo maps the @rbxts packages under rbxts_include/node_modules, but on disk they stay at the npm
+	-- location, so the emitted import path has to be folded back. Published packages ship .lua, not .luau.
+	local candidates = { path }
+	local folded = string.match(path, "^node_modules/roblox%-ts/include/node_modules/(.+)$")
+	if folded then
+		table.insert(candidates, "node_modules/" .. folded)
+	end
+
+	-- `engine` is three Rojo roots, not one: ReplicatedStorage.engine -> out/engine/shared,
+	-- StarterPlayerScripts.engine -> out/engine/client, ServerScriptService.engine -> out/engine/server.
+	-- CLASSIC_ROOTS can only name one of them, so try the siblings before giving up.
+	-- `TS` is service-scoped too: ReplicatedStorage.TS -> out/shared, ServerScriptService.TS -> out/server,
+	-- StarterPlayerScripts -> out/client. Same flat-roots limitation, same fix.
+	local gameRest = string.match(path, "^out/shared/(.+)$")
