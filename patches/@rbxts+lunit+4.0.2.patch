+-- Stand-in instances. Lune's own instances cannot carry WaitForChild, which module-scope code calls constantly,
+-- so these are small proxies covering just what an import needs: identity, children, attributes, IsA.
+-- An unrequested child is created on demand rather than erroring -- a headless load must never hang or throw
+-- on world shape it has no opinion about.
+local function stubInstance(name: string, className: string, children: { any }, attributes: { [string]: any })
+	local self
+	self = setmetatable({}, {
+		__index = function(_, key)
+			if key == "Name" then return name end
+			if key == "ClassName" then return className end
+			if key == "Parent" then return nil end
+			if key == "WaitForChild" or key == "FindFirstChild" then
+				return function(_, childName)
+					for _, child in children do
+						if child.Name == childName then return child end
+					end
+					local created = stubInstance(childName, "Folder", {}, {})
+					table.insert(children, created)
+					return created
+				end
+			end
+			if key == "GetChildren" or key == "GetDescendants" then
+				return function() return children end
+			end
+			if key == "GetAttribute" then
+				return function(_, attribute) return attributes[attribute] end
+			end
+			if key == "SetAttribute" then
+				return function(_, attribute, value) attributes[attribute] = value end
+			end
+			if key == "IsA" then
+				return function(_, wanted) return wanted == className end
+			end
+			if key == "GetTags" then
+				return function() return {} end
+			end
+			if key == "Destroy" or key == "Clone" then
+				return function() return self end
+			end
+			return nil
+		end,
+		__tostring = function() return name end,
